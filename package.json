{
  "name": "wristworks",
  "version": "0.1.0",
  "description": "NTP-calibrated multi-timezone clock fetcher with YAML/ENV config",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "wristworks": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./types": "./dist/types.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run build:native && tsc",
    "build:native": "napi build --manifest-path native/Cargo.toml --platform --release",
    "build:native:debug": "napi build --manifest-path native/Cargo.toml --platform",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "ntpclient": "^1.5.6",
    "js-yaml": "^4.1.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0",
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0",
    "@types/js-yaml": "^4.0.9",
    "tsx": "^4.19.0"
  },
  "napi": {
    "binaryName": "wristworks-core",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin"
    ]
  }
}
